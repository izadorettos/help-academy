# Copie para .env.local e preencha. Nunca commite .env.local.

# URL pública da aplicação (links de convite e recuperação de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
# Para local: valores obtidos com `npx supabase start` (campo API URL e anon key)
# Para staging/produção: valores do painel Supabase > Settings > API

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SOMENTE SERVIDOR — nunca use prefixo NEXT_PUBLIC_ nesta chave:
# Para local: service_role key da saída de `npx supabase start`
SUPABASE_SECRET_KEY=

# --- Demo (local only — não commitar) ---
# Gerada automaticamente por scripts/demo.mjs seed (npm run demo:seed).
# Usada para login do usuário demo@help.local em desenvolvimento e nos testes E2E de demo.
DEMO_USER_PASSWORD=

# --- Login ---
# supabase (padrão): usuários do Supabase Auth (dev/teste).
# help: login e senha validados na API do Core da HELP (docs/AUTH-PROVIDER.md).
AUTH_PROVIDER=supabase

# Obrigatórias com AUTH_PROVIDER=help:
# URL base da API do Core (sem barra final). O login usa a rota pública POST /usuario/login.
HELP_CORE_API_URL=
# SOMENTE SERVIDOR: o mesmo JWT_SECRET do Core — valida o accessToken devolvido no login.
HELP_CORE_JWT_SECRET=
# Site key pública do Cloudflare Turnstile (a mesma do Front da HELP). O Turnstile é
# obrigatório: o token vai junto no login e o Core o valida com TURNSTILE_SECRET_KEY.
# Teste local (sempre aprova): 1x00000000000000000000AA — o Core precisa da secret de teste
# 1x0000000000000000000000000000000AA.
HELP_TURNSTILE_SITE_KEY=
