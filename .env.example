# Copie para .env.local e preencha. Nunca commite .env.local.

# URL pública da aplicação (links de convite e recuperação de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
# Para local: valores obtidos com `npx supabase start` (campo API URL e anon key)
# Para staging/produção: valores do painel Supabase > Settings > API

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SOMENTE SERVIDOR — nunca use prefixo NEXT_PUBLIC_ nesta chave:
# Para local: service_role key da saída de `npx supabase start`
SUPABASE_SECRET_KEY=
